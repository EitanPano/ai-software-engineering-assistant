# Copy the values you need into your shell environment or a secret manager. For local development
# only, you may instead keep them in a git-ignored backend/.env, holding just the lines you need,
# and start with `uv run --env-file .env python -m app.main`; the app never loads it by itself, so
# the tests stay keyless. Never commit one, and never use one in production. Every variable the app
# reads is listed here with a placeholder and parsed in src/app/config/env.py, nowhere else.

# development, test or production.
APP_ENV=development
# Port the API listens on.
PORT=8000
# Proxy trust: true, false, a hop count (1 behind one reverse proxy), or a comma list of
# addresses, subnets and the presets loopback, linklocal and uniquelocal.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. Leave unset to disable CORS (no browser calls the API from another origin).
CORS_ORIGINS=
# Comma-separated host names the API answers to, besides localhost, 127.0.0.1 and [::1], which always work.
# Any other Host header is refused, which stops DNS rebinding. A public host must list its own name.
ALLOWED_HOSTS=
# Directory of a built single-page app to serve after the API (the single image sets it). Unset serves none.
STATIC_DIR=
# Signs access tokens. Required in production, at least 32 characters; a fake default applies elsewhere.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Signs refresh tokens. Required in production, at least 32 characters, different from the access secret.
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-32-chars-or-more
# Keys the one-time-code hash. Required in production, at least 32 characters.
OTP_SECRET=change-me-to-another-random-string-of-at-least-32-chars
# Base64 of 32 random bytes, encrypts stored secrets. Required in production.
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
# Cookie domain for auth cookies. Optional; unset keeps them host-only.
COOKIE_DOMAIN=
# Mail provider: console (prints in development) or a registered provider name.
MAIL_PROVIDER=console
# SMS provider: console or a registered provider name.
SMS_PROVIDER=console
# WhatsApp provider: console or a registered provider name.
WHATSAPP_PROVIDER=console
# Sender address. Required when MAIL_PROVIDER is not console.
MAIL_FROM=no-reply@example.com
# Run the scheduled jobs in this process: true or false.
JOBS_ENABLED=true
# Multiplies every rate limit (1 to 1000). Production keeps 1; an e2e run raises it so a journey suite
# is not limited. There is no switch that turns limiting off.
RATE_LIMIT_SCALE=1

# Anthropic API key for the agent. Required in production; a fake default applies elsewhere, and
# tests and e2e run on a scripted fake.
ANTHROPIC_API_KEY=change-me-with-your-anthropic-key
# The model the agent runs on, without a date suffix.
LLM_MODEL=claude-opus-5-5
# The model of the side call that extracts memories after a run, without a date suffix.
LLM_SIDE_MODEL=claude-haiku-5-5
# Points the SDK at another server (the scripted fake in e2e). Leave unset; refused in production.
ANTHROPIC_BASE_URL=

# Voyage AI key for the code embeddings (voyage-code-4, paid per token). Required in production; a
# fake default applies elsewhere, and tests and e2e run on a scripted fake.
VOYAGE_API_KEY=change-me-with-your-voyage-key
# Points the Voyage client at another server (the scripted fake in e2e). Leave unset; refused in production.
VOYAGE_BASE_URL=
# Points the GitHub client at another server (the scripted fake in e2e). Leave unset; refused in production.
GITHUB_BASE_URL=

# Which process this is: backend (the API and its commands), knowledge (the MCP server that offers
# the agent its search and recall tools; it needs only DATABASE_URL, VOYAGE_API_KEY and KNOWLEDGE_MCP_TOKEN) or
# github_gateway (holds GITHUB_MCP_PAT; it needs only that, GITHUB_MCP_TOKEN and
# GITHUB_MCP_UPSTREAM_URL). Required in production; elsewhere it defaults to backend.
APP_PROCESS=backend
# Where the agent reaches the knowledge MCP server (`uv run poe knowledge`, port 8001).
KNOWLEDGE_MCP_URL=http://127.0.0.1:8001/mcp
# Bearer token both sides share; the knowledge server refuses a call without it. Required in
# production, at least 32 characters; a fake default applies elsewhere.
KNOWLEDGE_MCP_TOKEN=change-me-to-a-random-string-of-at-least-32-chars

# Where the agent reaches the GitHub gateway (`uv run poe github-gateway`, port 8002).
GITHUB_MCP_URL=http://127.0.0.1:8002/mcp
# Bearer token the backend and the gateway share; the gateway refuses a call without it. Optional:
# unset keeps the GitHub server unreachable. At least 32 characters; generate it, never reuse a PAT.
GITHUB_MCP_TOKEN=
# The GitHub gateway is its own process (APP_PROCESS=github_gateway). It alone reads the personal
# access token, GITHUB_MCP_PAT, which belongs in a git-ignored backend/.env.github loaded by the
# gateway's terminal only (any other process refuses to boot with it), never in this file or in
# backend/.env. Where the gateway forwards (the github-mcp service in Compose):
GITHUB_MCP_UPSTREAM_URL=http://127.0.0.1:8082/

# database/postgres provider
# Postgres connection URL. Required in production; outside production it defaults to the local service.
# Tests (testDb) use postgres://app:app@127.0.0.1:5432/app_test; override with TEST_DATABASE_URL.
# Browser tests (e2eDb) use postgres://app:app@127.0.0.1:5432/app_e2e; override with E2E_DATABASE_URL.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
